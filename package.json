{
  "name": "@we-the-rebel-alliance/wisprflow-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Unofficial OpenCode plugin for Wispr Flow: its Notetaker meetings, transcripts, summaries, Scratchpad notes and calendar, through Wispr Flow's official MCP server",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "wisprflow"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-the-rebel-alliance/wisprflow-plugin.git"
  },
  "homepage": "https://github.com/we-the-rebel-alliance/wisprflow-plugin#readme",
  "bugs": {
    "url": "https://github.com/we-the-rebel-alliance/wisprflow-plugin/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "opencode": {
    "host": ">=2.4.1 <2.5.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "wisprflow",
      "name": "Wispr Flow",
      "domain": "wisprflow.ai",
      "mark": true
    }
  },
  "sources": {
    "contractVersion": 1,
    "rpc": "wisprflow.meetings.tools",
    "probe": {
      "action": "wisprflow_probe"
    },
    "items": [
      {
        "id": "wisprflow.meetings",
        "kind": "events",
        "reads": "meeting",
        "tool": "events_list",
        "input": {
          "source": "wisprflow"
        },
        "accounts": {
          "named": false
        },
        "permission": {
          "events": "wisprflow_events_list",
          "operations": [
            "search_meetings"
          ]
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 65536
      },
      {
        "id": "wisprflow.meetings.list",
        "kind": "snapshot",
        "tool": "events_list",
        "input": {
          "source": "wisprflow",
          "list": "meetings"
        },
        "output": "list",
        "accounts": {
          "named": false
        },
        "permission": {
          "tool": "wisprflow_events_list",
          "operations": [
            "search_meetings"
          ]
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxAgeSec": 900,
        "maxBytes": 65536
      }
    ]
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "conformance": "bun test ./test/conformance",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check.mjs forbidden",
    "drift": "node scripts/check-wisprflow-tools.mjs",
    "capture": "node scripts/capture-tools.mjs"
  },
  "devDependencies": {
    "@opencode/client": "2.4.1",
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/source-contract": "github:we-the-rebel-alliance/source-contract#v0.3.0",
    "esbuild": "0.28.2",
    "solid-js": "1.9.17",
    "typescript": "5.9.3"
  },
  "jelly": {
    "title": "Wispr Flow",
    "summary": "Your Wispr Flow meetings, notes and calendar.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "wisprflow.get_calendar_event",
        "permission": "wisprflow_get_calendar_event",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.get_meeting",
        "permission": "wisprflow_get_meeting",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.get_meeting_by_calendar_id",
        "permission": "wisprflow_get_meeting_by_calendar_id",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.get_meeting_participants_enriched",
        "permission": "wisprflow_get_meeting_participants_enriched",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.get_scratchpad_note",
        "permission": "wisprflow_get_scratchpad_note",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.get_upcoming_meeting",
        "permission": "wisprflow_get_upcoming_meeting",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.list_folder_meetings",
        "permission": "wisprflow_list_folder_meetings",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.list_folders",
        "permission": "wisprflow_list_folders",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.list_meeting_series",
        "permission": "wisprflow_list_meeting_series",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.list_upcoming_meetings",
        "permission": "wisprflow_list_upcoming_meetings",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.resolve_calendar_link",
        "permission": "wisprflow_resolve_calendar_link",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.resolve_share_link",
        "permission": "wisprflow_resolve_share_link",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.search_calendar_events",
        "permission": "wisprflow_search_calendar_events",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.search_meetings",
        "permission": "wisprflow_search_meetings",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.search_scratchpad_notes",
        "permission": "wisprflow_search_scratchpad_notes",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.events_list",
        "permission": "wisprflow_events_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "wisprflow.get_participant_contacts",
        "permission": "wisprflow_get_participant_contacts",
        "effect": "allow",
        "readOnly": true,
        "note": "Wispr Flow serves it only to accounts with Wispr Contacts. It reads other people's job titles, companies and LinkedIn profiles."
      }
    ],
    "skills": [
      "wisprflow",
      "wisprflow-meeting-brief"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "wisprflow",
        "label": "Wispr Flow",
        "server": "wisprflow"
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "default": "all",
          "description": "all, ask-changes or read-only. Generates default rules for agents with a base allow rule."
        }
      ]
    }
  }
}
